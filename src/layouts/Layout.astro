---
import "../styles/global.css";

interface Props {
	title?: string;
	lang?: string;
	theme?: "light" | "dark";
}

const { title = "SinfonIA Uniandes", lang = "en", theme = "light" } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={theme} class:list={[theme === "dark" && "theme-dark"]}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }

    html.theme-dark {
        color-scheme: dark;
        background: #101218;
    }

    html.theme-dark body {
        background: #101218;
    }
</style>
