---
import Layout from "./Layout.astro";
import sinfoniaMark from "../assets/sinfonia-static.svg?raw";
import sidebarSource from "../wiki/_Sidebar.md?raw";
import { parseWikiSidebar } from "../lib/wiki";

interface Props {
	title: string;
	currentId: string;
}

const { title, currentId } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");
const homeHref = `${baseUrl}/`;
const wikiHref = `${baseUrl}/wiki`;
const sections = parseWikiSidebar(sidebarSource, import.meta.env.BASE_URL);
---

<Layout title={`${title} · Wiki SinfonIA`} lang="es" theme="dark">
	<div class="wiki-shell">
		<header class="wiki-top">
			<a class="wiki-top__logo" href={homeHref} aria-label="SINFONiA home" set:html={sinfoniaMark} />
			<a class="wiki-top__title" href={wikiHref}>Wiki</a>
		</header>

		<div class="wiki-body">
			<aside class="wiki-sidebar">
				<nav aria-label="Wiki">
					{sections.map((section) => (
						<section class="wiki-nav-section">
							{section.title && <h2>{section.title}</h2>}
							{section.items.length > 0 && (
								<ul>
									{section.items.map((item) => (
										<li>
											<a
												href={item.href}
												aria-current={item.id === currentId ? "page" : undefined}
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							)}
						</section>
					))}
				</nav>
			</aside>

			<main class="wiki-main">
				<slot />
			</main>
		</div>
	</div>
</Layout>

<style>
	.wiki-shell {
		--wiki-bg: #101218;
		--wiki-sidebar: #141722;
		--wiki-text: #e6e4ee;
		--wiki-muted: #b4b1bd;
		--wiki-heading: #eef0ff;
		--wiki-link: #9aa3ff;
		--wiki-link-hover: #c5c9ff;
		--wiki-border: rgb(255 255 255 / 10%);
		--wiki-code: #0b0d16;
		min-height: 100svh;
		background: var(--wiki-bg);
		color: var(--wiki-text);
		color-scheme: dark;
	}

	.wiki-top {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem clamp(1rem, 4vw, 2rem);
		border-bottom: 1px solid var(--wiki-border);
		background: rgb(8 10 16 / 72%);
	}

	.wiki-top__logo {
		display: block;
		width: clamp(96px, 14vw, 128px);
	}

	.wiki-top__logo :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.wiki-top__logo :global(path[fill="rgb(91,90,96)"]) {
		fill: #eceaf2;
	}

	.wiki-top__logo :global(path[fill="rgb(32,35,161)"]) {
		fill: #8b92ff;
	}

	.wiki-top__title {
		color: var(--wiki-heading);
		font-family: "Montserrat", sans-serif;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.wiki-top__title:hover,
	.wiki-top__title:focus-visible {
		color: var(--wiki-link);
	}

	.wiki-top__title:focus-visible,
	.wiki-nav-section a:focus-visible,
	.wiki-main :global(.wiki-prose a:focus-visible) {
		outline: 2px dashed var(--yellow);
		outline-offset: 0.2rem;
	}

	.wiki-body {
		display: grid;
		grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr);
		align-items: start;
		max-width: 88rem;
		margin: 0 auto;
	}

	.wiki-sidebar {
		position: sticky;
		top: 0;
		box-sizing: border-box;
		max-height: 100svh;
		padding: 1.5rem 1.25rem 2.5rem;
		overflow: auto;
		background: var(--wiki-sidebar);
		border-right: 1px solid var(--wiki-border);
	}

	.wiki-nav-section + .wiki-nav-section {
		margin-top: 1.5rem;
	}

	.wiki-nav-section h2 {
		margin: 0 0 0.65rem;
		color: var(--yellow);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.wiki-nav-section ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.wiki-nav-section a {
		display: block;
		padding: 0.32rem 0.5rem 0.32rem 0.15rem;
		border-left: 2px solid transparent;
		color: var(--wiki-muted);
		font-size: 0.92rem;
		line-height: 1.35;
		text-decoration: none;
	}

	.wiki-nav-section a:hover,
	.wiki-nav-section a:focus-visible {
		color: var(--wiki-heading);
	}

	.wiki-nav-section a[aria-current="page"] {
		border-left-color: var(--yellow);
		color: var(--wiki-heading);
		font-weight: 700;
	}

	.wiki-main {
		box-sizing: border-box;
		min-width: 0;
		padding: 1.75rem clamp(1.1rem, 4vw, 2.75rem) 4rem;
	}

	.wiki-main :global(.wiki-prose) {
		max-width: 52rem;
	}

	.wiki-main :global(.wiki-prose > :first-child) {
		margin-top: 0;
	}

	.wiki-main :global(.wiki-prose h1),
	.wiki-main :global(.wiki-prose h2),
	.wiki-main :global(.wiki-prose h3),
	.wiki-main :global(.wiki-prose h4) {
		color: var(--wiki-heading);
		line-height: 1.2;
	}

	.wiki-main :global(.wiki-prose h1) {
		margin: 0 0 1rem;
		font-size: clamp(1.7rem, 4vw, 2.4rem);
	}

	.wiki-main :global(.wiki-prose h2) {
		margin: 2rem 0 0.75rem;
		font-size: 1.35rem;
	}

	.wiki-main :global(.wiki-prose h3),
	.wiki-main :global(.wiki-prose h4) {
		margin: 1.4rem 0 0.5rem;
	}

	.wiki-main :global(.wiki-prose p),
	.wiki-main :global(.wiki-prose li) {
		line-height: 1.6;
	}

	.wiki-main :global(.wiki-prose a) {
		color: var(--wiki-link);
	}

	.wiki-main :global(.wiki-prose a:hover),
	.wiki-main :global(.wiki-prose a:focus-visible) {
		color: var(--wiki-link-hover);
	}

	.wiki-main :global(.wiki-prose img) {
		max-width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}

	.wiki-main :global(.wiki-prose pre) {
		padding: 1rem;
		overflow-x: auto;
		background: var(--wiki-code);
		border: 1px solid var(--wiki-border);
		border-radius: 0.75rem;
	}

	.wiki-main :global(.wiki-prose code) {
		font-size: 0.92em;
	}

	.wiki-main :global(.wiki-prose :not(pre) > code) {
		padding: 0.1em 0.35em;
		background: rgb(255 255 255 / 8%);
		border-radius: 0.3rem;
	}

	.wiki-main :global(.wiki-prose table) {
		width: 100%;
		margin: 1.25rem 0;
		border-collapse: collapse;
	}

	.wiki-main :global(.wiki-prose td),
	.wiki-main :global(.wiki-prose th) {
		padding: 0.75rem;
		vertical-align: top;
	}

	.wiki-main :global(.wiki-prose hr) {
		margin: 2rem 0;
		border: 0;
		border-top: 1px solid var(--wiki-border);
	}

	.wiki-main :global(.wiki-prose blockquote) {
		margin: 1.25rem 0;
		padding: 0.2rem 0 0.2rem 1rem;
		color: var(--wiki-muted);
		border-left: 3px solid var(--yellow);
	}

	@media (max-width: 52rem) {
		.wiki-body {
			grid-template-columns: 1fr;
		}

		.wiki-sidebar {
			position: static;
			max-height: none;
			border-right: 0;
			border-bottom: 1px solid var(--wiki-border);
		}
	}
</style>
