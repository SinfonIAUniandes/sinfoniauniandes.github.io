---
interface Props {
  size?: string;
  label?: string;
}

const { size = '6rem', label = 'Loading' } = Astro.props;
---

<div class="loading" role="status" aria-label={label} style={`--loading-size: ${size}`}>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <g fill="none" stroke="rgb(34,211,238)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
      <line x1="42.93" y1="42.93" x2="29.78" y2="29.78" />
      <line x1="56.2" y1="42.16" x2="65.59" y2="30.31" />
      <line x1="59.66" y1="52.56" x2="78.69" y2="57.59" />
      <line x1="43.62" y1="57.7" x2="29.51" y2="74.76" />

      <circle cx="50" cy="50" r="10" />
      <circle cx="22" cy="22" r="11" />
      <circle cx="69" cy="26" r="5.5" />
      <circle cx="84" cy="59" r="5.5" />
      <circle cx="26" cy="79" r="5.5" />
    </g>
  </svg>
</div>

<style>
  .loading {
    display: inline-grid;
    width: var(--loading-size);
    aspect-ratio: 1;
    place-items: center;
  }

  svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: center;
    animation: rotate-network 1.8s linear infinite;
  }

  @keyframes rotate-network {
    0% {
      transform: rotate(0deg);
      animation-timing-function: ease-in-out;
    }

    25% {
      transform: rotate(90deg);
      animation-timing-function: ease-in-out;
    }

    50% {
      transform: rotate(180deg);
      animation-timing-function: ease-in-out;
    }

    75% {
      transform: rotate(270deg);
      animation-timing-function: ease-in-out;
    }

    100% {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    svg {
      animation: none;
    }
  }
</style>
