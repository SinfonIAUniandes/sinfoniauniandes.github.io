---
import figure from "../../assets/pepper/Pepper-the-Robot-PNG.png";
import JoinBlocked from "./JoinBlocked.astro";

const headline = ["Robots", "sociales,", "en", "espacios", "reales."];

const bubbles = [
	{ text: "¡Hola!", tone: "var(--pop-red)", className: "bubble--a", at: "2.35s" },
];

---

<div class="hero">
	<span class="hero__aura" aria-hidden="true"></span>
	<div class="shell hero__shell">
		<div class="hero__grid">
			<div class="hero__copy">
				<p class="eyebrow hero__item" style="--at: 1.45s">Investigación abierta, robots entre personas</p>

				<h1 style="--at: 1.58s">
					{
						headline.map((word, index) => (
							<span class="hero__word" style={`--i: ${index}`}>{word} </span>
						))
					}
				</h1>

				<p class="lede hero__item" style="--at: 1.78s">
					Una iniciativa estudiantil de la Universidad de los Andes, en Bogotá.
				</p>
				<p class="lede hero__item" style="--at: 1.86s">
					Hacemos investigación OpenSource y llevamos a Nova, a Ópera y a Orión a espacios
					reales donde interactúan con humanos.
				</p>

				<div class="actions hero__item" style="--at: 1.94s">
					<JoinBlocked />
					<a class="action action--quiet" href="#robocup">Mira el camino hasta Eindhoven</a>
				</div>
			</div>

			<div class="hero__art">
				<div class="hero__enter hero__item" style="--at: 1.5s">
					<div class="hero__stage">
						<img
							class="hero__figure"
							src={figure.src}
							width={figure.width}
							height={figure.height}
							alt="Nova, un robot de SinfonIA, con un brazo en alto y la marca Uniandes en su tableta"
							fetchpriority="high"
							decoding="async"
						/>
						<div class="hero__bubbles" aria-hidden="true">
							{
								bubbles.map((bubble) => (
									<span
										class:list={["bubble", bubble.className]}
										style={`--tone: ${bubble.tone}; --at: ${bubble.at}`}
									>
										{bubble.text}
									</span>
								))
							}
						</div>
					</div>
				</div>
				<span class="hero__floor" aria-hidden="true"></span>
			</div>
		</div>

	</div>
</div>

<style>
	.hero {
		position: relative;
	}

	/*
		.hero__shell es la columna flex de alto completo, no .hero, porque la
		sección y el envoltorio shell son dos elementos distintos.
	*/
	.hero__shell {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: 100svh;
		box-sizing: border-box;
		padding-block: clamp(4.5rem, 8vh, 5.5rem) 0;
	}

	/*
		Manchas de color que respiran detrás del héroe, con las tintas del
		logotipo. Van muy suaves para no competir con el texto.
	*/
	.hero__aura {
		position: absolute;
		inset: -12% -18% -4% -18%;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(38% 46% at 78% 30%, rgb(219 62 59 / 11%), transparent 70%),
			radial-gradient(34% 42% at 62% 72%, rgb(196 197 81 / 13%), transparent 70%),
			radial-gradient(46% 52% at 26% 40%, rgb(32 35 161 / 8%), transparent 72%);
		filter: blur(2px);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__aura {
			animation: drift 22s ease-in-out infinite alternate;
		}
	}

	/* Las palabras del titular entran una a una, como se traza el logotipo. */
	.hero__word {
		display: inline-block;
		white-space: pre;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero__word {
			opacity: 0;
			animation: word-rise 0.72s cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
			animation-delay: calc(1.58s + var(--i) * 0.09s);
		}
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
		align-items: end;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		flex: 1;
		min-height: 0;
	}

	.hero__copy {
		align-self: center;
	}

	h1 {
		max-width: 16ch;
		font-size: clamp(2.4rem, 5.2vw, 4.4rem);
		line-height: 1;
		text-wrap: balance;
	}

	/*
		Tres cajas anidadas a propósito. El parallax del scroll, la entrada y la
		flotación animan transform, y dos animaciones sobre un mismo elemento se
		reemplazan en vez de combinarse.
	*/
	.hero__art {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		height: 100%;
		min-height: 0;
		margin-right: calc(var(--gutter) * -0.5);
	}

	.hero__enter {
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		width: 100%;
		transition: translate 0.4s ease-out;
	}

	/*
		El escenario se encoge al retrato: las burbujas se anclan al robot,
		no a la columna vacía a su izquierda.
	*/
	.hero__stage {
		position: relative;
	}

	.hero__figure {
		display: block;
		width: auto;
		height: clamp(22rem, 82svh, 48rem);
		max-height: calc(100svh - 4.5rem);
		object-fit: contain;
		object-position: bottom right;
	}

	.hero__floor {
		position: absolute;
		bottom: 0;
		left: 6%;
		right: 0;
		height: 1px;
		background: var(--line);
	}

	/*
		El suelo no está desde el primer cuadro: se traza al asentarse el
		logotipo, junto con la entrada del robot.
	*/
	@media (prefers-reduced-motion: no-preference) {
		.hero__floor {
			opacity: 0;
			transform: scaleX(0);
			transform-origin: left;
			animation: floor-draw 0.8s cubic-bezier(0.2, 0.75, 0.25, 1) 2.05s forwards;
		}
	}

	@keyframes floor-draw {
		to {
			opacity: 1;
			transform: scaleX(1);
		}
	}

	/*
		Burbujas de conversación alrededor del robot: la interacción
		humano-robot que buscamos, dicha sin palabras de más.
	*/
	.hero__bubbles {
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: translate 0.55s ease-out;
		translate: calc(var(--px, 0) * -16px) calc(var(--py, 0) * -11px);
	}

	.bubble {
		position: absolute;
		padding: 0.55rem 1rem;
		border: 1px solid;
		border-color: color-mix(in srgb, var(--tone) 42%, white);
		border-radius: 1.4rem;
		background: rgb(255 255 255 / 92%);
		color: var(--tone);
		font-family: var(--display);
		font-size: clamp(0.85rem, 1.5vw, 1.02rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: 0 12px 26px rgb(23 23 26 / 8%);
	}

	/* La colita apunta hacia abajo, a la cabeza de Nova. */
	.bubble::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: -0.36rem;
		width: 0.72rem;
		height: 0.72rem;
		margin-left: -0.36rem;
		border-right: 1px solid;
		border-bottom: 1px solid;
		border-color: inherit;
		border-radius: 0 0 0.22rem 0;
		background: rgb(255 255 255 / 92%);
		transform: rotate(45deg);
	}

	/*
		La burbuja sale por encima de la cabeza (que empieza al 7 % de la imagen
		y está centrada al 50 %): la colita se hunde en el contorno, como si la
		voz saliera del robot. Al usar porcentajes sirve en todo tamaño.
	*/
	.bubble--a {
		top: 7.5%;
		left: 50%;
		right: auto;
		transform: translate(-50%, -100%);
	}

	/*
		La entrada anima `scale` y `opacity`, no `transform`, para no pisar el
		centrado de la burbuja.
	*/
	@keyframes pop-in-a {
		from {
			opacity: 0;
			scale: 0.62;
		}

		to {
			opacity: 1;
			scale: 1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.bubble {
			opacity: 0;
			animation:
				pop-in-a 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.2) var(--at, 2.35s) forwards,
				bob 5.5s ease-in-out calc(var(--at, 2.35s) + 0.6s) infinite alternate;
		}
	}

	@media (max-width: 60rem) {
		.hero__shell {
			justify-content: flex-start;
			padding-block: clamp(4.5rem, 12vw, 5.5rem) 1.5rem;
		}

		.hero__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		.hero__art {
			order: -1;
			justify-content: center;
			min-height: 0;
			margin-right: 0;
		}

		.hero__enter {
			justify-content: center;
		}

		.hero__figure {
			height: clamp(11rem, 30vh, 17rem);
			object-position: bottom center;
		}

		.hero__floor {
			left: 0;
		}
	}

</style>

<script>
	/*
		El héroe sigue al cursor con un parallax suave: el robot se acerca un
		poco a quien lo mira. Se mueve con la propiedad `translate` para no
		pelear con las animaciones de entrada y flotación, que usan `transform`.
	*/
	const hero = document.querySelector<HTMLElement>(".hero");
	const figure = document.querySelector<HTMLElement>(".hero__enter");

	if (hero && figure && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		hero.addEventListener(
			"pointermove",
			(event) => {
				const rect = hero.getBoundingClientRect();
				const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
				const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
				figure.style.translate = `${x * -11}px ${y * -7}px`;
				hero.style.setProperty("--px", x.toFixed(3));
				hero.style.setProperty("--py", y.toFixed(3));
			},
			{ passive: true }
		);

		hero.addEventListener("pointerleave", () => {
			figure.style.translate = "0 0";
			hero.style.setProperty("--px", "0");
			hero.style.setProperty("--py", "0");
		});
	}
</script>
