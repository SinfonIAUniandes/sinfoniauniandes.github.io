---
import opera from "../../assets/pepper/Pepper Robot-1.png";
import nova from "../../assets/pepper/PEP_Pack07_001 (2).webp";

const fleet = [
	{
		name: "Ópera",
		note: "La primera Pepper que recibió esta casa, cuando la alianza era de cuatro.",
		image: opera,
		alt: "Ópera, la primera Pepper, de pie con los brazos abiertos",
	},
	{
		name: "Nova",
		note: "La que viaja. Nova ha estado en Sídney, Bangkok, Burdeos y Eindhoven.",
		image: nova,
		alt: "Nova, la Pepper que viaja a las competencias, con una mano en alto",
	},
];

const chores = [
	{ name: "Recepcionista", note: "Recibe visitas, toma recados y busca a quien se necesite." },
	{ name: "Equipaje", note: "Recoge un bolso del suelo y lo lleva a la habitación correcta." },
	{ name: "Desayuno", note: "Lleva una bandeja por una puerta y la deja sobre la mesa." },
	{ name: "Mercado", note: "Desempaca una bolsa y guarda el mercado en su lugar." },
	{ name: "Reglas de la casa", note: "Respeta las normas que alguien pone en un espacio compartido." },
	{ name: "Recoger la mesa", note: "Recoge lo usado y lo lleva de vuelta a la cocina." },
	{
		name: "Un pedido sin guión",
		note: "Alguien le pide algo que nadie programó. El robot escucha, entiende y decide.",
	},
];
---

<section id="fleet" class="band band--tint">
	<div class="shell">
		<h2 class="reveal">Dos robots y una lista de cosas de casa.</h2>

		<p class="lede reveal" style="--step: 1">
			Ópera fue la primera. Nova es la que viaja.
		</p>
		<p class="lede reveal" style="--step: 2">
			En @Home las pruebas parecen de casa a propósito.
		</p>
		<p class="lede reveal" style="--step: 3">
			Si un robot no sabe llevar una bandeja, no tiene nada que hacer entre personas.
		</p>

		<div class="fleet">
			{
				fleet.map((robot, index) => (
					<figure class="fleet__unit reveal" style={`--step: ${index + 1}`}>
						<img
							src={robot.image.src}
							width={robot.image.width}
							height={robot.image.height}
							alt={robot.alt}
							loading="lazy"
							decoding="async"
						/>
						<figcaption>
							<h3>{robot.name}</h3>
							<p>{robot.note}</p>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>

	<div class="chores-wrap">
		<div class="chores-nav">
			<button class="chores-arrow" type="button" data-dir="-1" aria-label="Ver la tarea anterior">
				←
			</button>
			<button class="chores-arrow" type="button" data-dir="1" aria-label="Ver la tarea siguiente">
				→
			</button>
		</div>

		<div class="chores-rail">
			<ul class="chores" role="list" tabindex="0" aria-label="Cosas de casa que el robot aprende a hacer. Avanza sola; pasa el cursor, enfócala o usa las flechas para detenerla.">
				{
					chores.map((chore, index) => (
						<li class="chore reveal" style={`--step: ${index % 4}`}>
							<h3>{chore.name}</h3>
							<p>{chore.note}</p>
						</li>
					))
				}
			</ul>
			<span class="chores-fade chores-fade--start" aria-hidden="true"></span>
			<span class="chores-fade chores-fade--end" aria-hidden="true"></span>
		</div>
	</div>
</section>

<style>
	.fleet {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 3.5rem);
		margin-top: clamp(2.5rem, 6vh, 4rem);
	}

	.fleet__unit {
		margin: 0;
	}

	.fleet__unit img {
		display: block;
		width: auto;
		height: clamp(13rem, 30vw, 21rem);
		object-fit: contain;
		object-position: bottom left;
	}

	.fleet__unit:nth-child(2) img {
		margin-left: auto;
		object-position: bottom right;
	}

	.fleet__unit figcaption {
		margin-top: 1.1rem;
		padding-top: 0.85rem;
		border-top: 1px solid var(--line-strong);
	}

	.fleet__unit h3 {
		margin: 0;
		font-size: clamp(1.4rem, 2.6vw, 2rem);
	}

	.fleet__unit p {
		max-width: 26rem;
		margin-top: 0.5rem;
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	/*
		Son siete tareas, así que van en un carrusel lateral en vez de una séptima
		línea de texto. El script de abajo duplica las tarjetas para que el riel
		avance solo en bucle, sin borde final.
	*/
	.chores-wrap {
		width: min(100% - var(--gutter) * 2, var(--shell));
		margin: clamp(3rem, 7vh, 4.5rem) auto 0;
		pointer-events: none;
	}

	/* El riel contiene la lista y los degradados de borde. */
	.chores-rail {
		position: relative;
	}

	.chores {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(13rem, 17rem);
		gap: 0;
		/* Margen negativo + relleno: sitio para el levantamiento del hover
		   sin mover el layout, porque el contenedor recorta en vertical. */
		margin: -0.8rem 0 0;
		padding: 0.8rem 0 0.9rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		list-style: none;
	}

	.chores::-webkit-scrollbar {
		display: none;
	}

	.chores:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 0.5rem;
	}

	.chore {
		padding: 1.15rem 1.35rem 1.15rem 1.25rem;
		margin-right: 1.5rem;
		border-top: 1px solid var(--line-strong);
	}

	.chore h3 {
		margin: 0;
		font-size: 1.28rem;
		letter-spacing: -0.028em;
	}

	.chore p {
		margin-top: 0.55rem;
		color: var(--ink-soft);
		font-size: 0.92rem;
		line-height: 1.5;
	}

	.chores-nav,
	.chores-rail {
		pointer-events: auto;
	}

	.chores-nav {
		display: flex;
		gap: 0.55rem;
		justify-content: flex-end;
		margin-bottom: 1rem;
	}

	.chores-arrow {
		display: grid;
		place-items: center;
		width: 2.55rem;
		height: 2.55rem;
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 1.05rem;
		line-height: 1;
		cursor: pointer;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.chores-arrow:hover {
		border-color: var(--accent);
	}

	.chores-arrow:active {
		transform: translateY(1px);
	}

	.chores-arrow:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 0.25rem;
	}

	.chores-fade {
		position: absolute;
		top: 0.8rem;
		bottom: 0.9rem;
		width: clamp(1.75rem, 5vw, 4.5rem);
		pointer-events: none;
	}

	.chores-fade--start {
		left: 0;
		background: linear-gradient(to right, var(--tint), rgb(244 244 248 / 0%));
	}

	.chores-fade--end {
		right: 0;
		background: linear-gradient(to left, var(--tint), rgb(244 244 248 / 0%));
	}

	@media (max-width: 48rem) {
		.fleet {
			grid-template-columns: minmax(0, 1fr);
		}

		.fleet__unit img {
			height: clamp(12rem, 40vw, 17rem);
		}

		.fleet__unit:nth-child(2) img {
			margin-left: 0;
		}
	}
</style>

<script>
	/*
		Carrusel de tareas: el riel se desplaza solo y hace bucle sin costura.
		Las tarjetas se duplican una vez; al llegar a la segunda copia se regresa
		a la primera con el mismo aspecto, así nunca hay una última tarjeta
		inalcanzable. Al pasar el cursor, enfocar o arrastrar el riel frena; al
		soltar, vuelve a rodar. No avanza con "prefers-reduced-motion".
	*/
	const SPEED = 30; // píxeles por segundo
	const BRAKE_TAU = 0.55;
	const ROLL_TAU = 0.4;

	function setupCarousel(wrap: HTMLElement) {
		const track = wrap.querySelector<HTMLElement>(".chores");
		const rail = wrap.querySelector<HTMLElement>(".chores-rail");
		const nav = wrap.querySelector<HTMLElement>(".chores-nav");
		if (!track || !rail) return;

		const originals = Array.from(track.children) as HTMLElement[];
		if (originals.length === 0) return;

		for (const item of originals) {
			const clone = item.cloneNode(true) as HTMLElement;
			clone.setAttribute("aria-hidden", "true");
			// Las copias no repiten la entrada animada ni son parte del anuncio.
			clone.classList.remove("reveal");
			clone.style.removeProperty("--step");
			track.appendChild(clone);
		}

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let loopWidth = 0;
		let target = reduceMotion.matches ? 0 : SPEED;
		let velocity = target;
		let last = 0;
		let hovering = false;
		let driven = true;
		let resumeTimer = 0;

		const measure = () => {
			loopWidth = track.scrollWidth / 2;
		};
		measure();
		new ResizeObserver(measure).observe(track);

		const inside = (node: EventTarget | null) => {
			if (!(node instanceof Node)) return false;
			return rail.contains(node) || Boolean(nav?.contains(node));
		};

		const pause = () => {
			target = 0;
			window.clearTimeout(resumeTimer);
		};

		const resume = (delay = 0) => {
			window.clearTimeout(resumeTimer);
			if (hovering || reduceMotion.matches) return;
			resumeTimer = window.setTimeout(() => {
				if (!hovering && !reduceMotion.matches) target = SPEED;
			}, delay);
		};

		const onEnter = () => {
			hovering = true;
			pause();
		};

		const onLeave = (event: PointerEvent) => {
			if (inside(event.relatedTarget)) return;
			hovering = false;
			resume();
		};

		rail.addEventListener("pointerenter", onEnter);
		rail.addEventListener("pointerleave", onLeave);
		nav?.addEventListener("pointerenter", onEnter);
		nav?.addEventListener("pointerleave", onLeave);

		track.addEventListener("focusin", onEnter);
		track.addEventListener("focusout", (event) => {
			if (inside(event.relatedTarget)) return;
			hovering = false;
			resume();
		});

		track.addEventListener("wheel", () => {
			pause();
			resume(1200);
		}, { passive: true });

		reduceMotion.addEventListener("change", () => {
			if (reduceMotion.matches) {
				velocity = 0;
				pause();
			} else resume();
		});

		for (const arrow of wrap.querySelectorAll<HTMLButtonElement>(".chores-arrow")) {
			arrow.addEventListener("click", () => {
				const card = originals[0];
				const gap = parseFloat(getComputedStyle(card).marginRight) || 0;
				const step = card.getBoundingClientRect().width + gap;
				driven = false;
				velocity = 0;
				pause();
				track.scrollBy({ left: Number(arrow.dataset.dir) * step, behavior: "smooth" });
				window.clearTimeout(resumeTimer);
				resumeTimer = window.setTimeout(() => {
					driven = true;
					resume();
				}, 700);
			});
		}

		const frame = (now: number) => {
			const dt = last ? Math.min(now - last, 120) / 1000 : 0;
			last = now;

			if (dt > 0 && driven) {
				const tau = target === 0 ? BRAKE_TAU : ROLL_TAU;
				velocity += (target - velocity) * (1 - Math.exp(-dt / tau));
			}

			if (driven && loopWidth > 0 && Math.abs(velocity) > 0.04) {
				track.scrollLeft += velocity * dt;
				// La segunda mitad del contenido es copia de la primera: volver
				// atrás al cruzarla no cambia lo que se ve.
				if (track.scrollLeft >= loopWidth) track.scrollLeft -= loopWidth;
				else if (track.scrollLeft < 0) track.scrollLeft += loopWidth;
			}
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	}

	for (const wrap of document.querySelectorAll<HTMLElement>(".chores-wrap")) {
		setupCarousel(wrap);
	}
</script>
