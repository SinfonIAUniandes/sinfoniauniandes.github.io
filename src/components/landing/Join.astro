---
import face from "../../assets/pepper/pepper.png";
import JoinBlocked from "./JoinBlocked.astro";

const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");

const contacts = [
	{ label: "Correo", value: "sinfonia@uniandes.edu.co", href: "mailto:sinfonia@uniandes.edu.co" },
	{ label: "Edificio", value: "Laboratorio Colivri - ML102" },
	{ label: "Código", value: "github.com/SinfonIAUniandes", href: "https://github.com/SinfonIAUniandes" },
	{ label: "Wiki", value: "Las notas del día a día, en español", href: `${baseUrl}/wiki` },
	{ label: "Camino", value: "Hall of Fame", href: `${baseUrl}/hall-of-fame` },
];

type Repo = {
	name: string;
	url: string;
	description: string;
	language: string | null;
	stars: number;
};

async function fetchPublicRepos(): Promise<Repo[]> {
	const collected: {
		name: string;
		html_url: string;
		description: string | null;
		language: string | null;
		stargazers_count: number;
		archived: boolean;
		pushed_at: string;
	}[] = [];

	for (let page = 1; page <= 5; page++) {
		const response = await fetch(
			`https://api.github.com/orgs/SinfonIAUniandes/repos?per_page=100&page=${page}&type=public&sort=updated`,
			{
				headers: {
					Accept: "application/vnd.github+json",
					"User-Agent": "sinfonia-website",
				},
			},
		);
		if (!response.ok) break;
		const batch = await response.json();
		if (!Array.isArray(batch) || batch.length === 0) break;
		collected.push(...batch);
		if (batch.length < 100) break;
	}

	return collected
		.filter((repo) => !repo.archived)
		.sort((a, b) => +new Date(b.pushed_at) - +new Date(a.pushed_at))
		.map((repo) => ({
			name: repo.name,
			url: repo.html_url,
			description: repo.description?.trim() ?? "",
			language: repo.language,
			stars: repo.stargazers_count,
		}));
}

let repos: Repo[] = [];
try {
	repos = await fetchPublicRepos();
} catch {
	repos = [];
}
---

<section id="join" class="band">
	<div class="shell">
		<div class="join">
			<div class="join__copy">
				<h2 class="reveal">Hay un lugar en la mesa para cualquier disciplina.</h2>

				<p class="lede reveal" style="--step: 1">
					Cada semestre se sienta gente nueva: de eléctrica, de sistemas, de mecánica, de
					derecho, de diseño.
				</p>
				<p class="lede reveal" style="--step: 2">
					No hace falta llegar sabiendo. Escríbenos, pasa por el ML102 o lee la wiki con calma.
				</p>

				<div class="actions reveal" style="--step: 2">
					<JoinBlocked />
					<a class="action action--quiet" href={`${baseUrl}/wiki`}>Lee la wiki</a>
				</div>

				<dl class="contacts">
					{
						contacts.map((contact, index) => (
							<div class="contact reveal" style={`--step: ${index + 1}`}>
								<dt>{contact.label}</dt>
								<dd>
									{
										contact.label === "Edificio" ? (
											<>
												Laboratorio{" "}
												<a
													class="colivri-cta"
													href="https://colivri.uniandes.edu.co/"
													target="_blank"
													rel="noreferrer"
												>
													Colivri
												</a>
												{" - ML102"}
											</>
										) : contact.href ? (
											<a href={contact.href}>{contact.value}</a>
										) : (
											contact.value
										)
									}
								</dd>
							</div>
						))
					}
				</dl>

			</div>

			<figure class="join__plate reveal" style="--step: 1">
				<img
					src={face.src}
					width={face.width}
					height={face.height}
					alt="Primer plano de Nova mirando a la cámara"
					loading="lazy"
					decoding="async"
				/>
				<span class="join__bubble" aria-hidden="true">¡Ven al ML102!</span>
				<figcaption>Nova.</figcaption>
			</figure>

			<div class="repos reveal">
				<div class="repos__head">
					<p class="label">Código abierto</p>
					<div class="repos__nav">
						<button class="repos__btn" type="button" data-dir="-1" aria-label="Repositorios anteriores">
							<span aria-hidden="true">←</span>
						</button>
						<button class="repos__btn" type="button" data-dir="1" aria-label="Repositorios siguientes">
							<span aria-hidden="true">→</span>
						</button>
					</div>
				</div>
				<div class="repos__viewport">
					<ul class="repos__track" role="list">
						{
							repos.map((repo, index) => (
								<li style={`--tone: var(--tone-${(index % 4) + 1})`}>
									<a class="repo" href={repo.url} target="_blank" rel="noreferrer">
										<span class="repo__dots" aria-hidden="true">
											<i></i><i></i><i></i><i></i>
										</span>
										<span class="repo__name mono">{repo.name}</span>
										<span class="repo__desc">{repo.description || "Sin descripción todavía."}</span>
										<span class="repo__meta">
											{
												repo.language ? (
													<span class="repo__lang">
														<i></i>
														{repo.language}
													</span>
												) : null
											}
											{
												repo.stars > 0 ? (
													<span class="repo__stars">{repo.stars} ★</span>
												) : null
											}
											<span class="repo__go">Abrir</span>
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<p class="note repos__note">
					{
						repos.length
							? `${repos.length} repositorios públicos. Si te da curiosidad, entra: la investigación OpenSource se lee en voz alta.`
							: "Si te da curiosidad, entra al GitHub de SinfonIA: la investigación OpenSource se lee en voz alta."
					}
					{" "}
					<a href="https://github.com/SinfonIAUniandes">github.com/SinfonIAUniandes</a>
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.join {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		grid-template-areas:
			"copy plate"
			"repos repos";
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}

	.join__copy {
		grid-area: copy;
		min-width: 0;
	}

	.join__plate {
		grid-area: plate;
		min-width: 0;
	}

	.contacts {
		margin: clamp(2.5rem, 6vh, 3.5rem) 0 0;
		padding: 0;
		border-bottom: 1px solid var(--line);
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
		gap: 1rem;
		padding-block: 0.7rem;
		border-top: 1px solid var(--line);
	}

	.contact dt {
		color: var(--ink-faint);
		font-family: var(--mono);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		line-height: 1.7;
		text-transform: uppercase;
	}

	.contact dd {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.55;
	}

	.colivri-cta {
		font-weight: 600;
		text-underline-offset: 0.18em;
	}

	.repos {
		grid-area: repos;
		position: relative;
		z-index: 1;
		min-width: 0;
		margin-top: 0;
		padding-top: 0.2rem;
		background: var(--paper);
	}

	.repos__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}

	.repos__head .label {
		margin: 0;
	}

	.repos__nav {
		display: flex;
		gap: 0.4rem;
	}

	.repos__btn {
		display: grid;
		place-items: center;
		width: 2.2rem;
		height: 2.2rem;
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink);
		font: inherit;
		line-height: 1;
		cursor: pointer;
	}

	.repos__btn:hover,
	.repos__btn:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}

	.repos__viewport {
		overflow: hidden;
	}

	.repos__track {
		display: flex;
		gap: 0.85rem;
		margin: 0;
		padding: 0.15rem 0 0.4rem;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: none;
		scrollbar-width: none;
	}

	.repos__track::-webkit-scrollbar {
		display: none;
	}

	.repos__track li {
		flex: 0 0 min(18.5rem, 78%);

	}

	.repo {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		min-height: 11.2rem;
		height: 100%;
		padding: 1.05rem 1.15rem 0.95rem 1.2rem;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--tone) 26%, var(--line));
		border-radius: 0.9rem;
		background:
			radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--tone) 16%, white), transparent 64%),
			var(--paper);
		color: var(--ink);
		text-decoration: none;
		box-shadow: inset 0.42rem 0 0 var(--tone);
		transition:
			border-color 0.22s ease,
			translate 0.22s ease,
			box-shadow 0.22s ease,
			background 0.22s ease;
	}

	.repo::before {
		content: "";
		position: absolute;
		top: 0;
		right: 1.15rem;
		left: 1.15rem;
		height: 3px;
		border-radius: 0 0 999px 999px;
		background: var(--tone);
	}

	.repo,
	.repo:hover,
	.repo:focus-visible {
		color: var(--ink);
		text-decoration: none;
	}

	.repo:hover,
	.repo:focus-visible {
		border-color: var(--tone);
		translate: 0 -0.2rem;
		box-shadow:
			inset 0.42rem 0 0 var(--tone),
			0 16px 30px color-mix(in srgb, var(--tone) 18%, transparent);
	}

	.repo__dots {
		display: flex;
		gap: 0.28rem;
	}

	.repo__dots i {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
	}

	.repo__dots i:nth-child(1) {
		background: var(--pop-gray);
	}

	.repo__dots i:nth-child(2) {
		background: var(--pop-red);
	}

	.repo__dots i:nth-child(3) {
		background: var(--pop-gold);
	}

	.repo__dots i:nth-child(4) {
		background: var(--pop-blue);
	}

	.repo__name {
		color: var(--ink);
		font-size: 0.9rem;
		line-height: 1.35;
		word-break: break-word;
	}

	.repo__desc {
		flex: 1;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		color: var(--ink-soft);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.repo__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink-faint);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.repo__lang {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.repo__lang i {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--tone);
	}

	.repo__stars {
		color: var(--pop-gold);
	}

	.repo__go {
		margin-left: auto;
		color: var(--tone);
		letter-spacing: 0.08em;
	}

	.repos__note {
		margin-top: 0.9rem;
		font-size: 0.92rem;
	}

	.join__plate {
		margin: 0;
	}

	/* Un aura del color del logotipo detrás del retrato. */
	.join__plate::before {
		content: "";
		position: absolute;
		inset: -6% -9%;
		z-index: -1;
		border-radius: 2.5rem;
		background:
			radial-gradient(60% 55% at 74% 24%, rgb(219 62 59 / 12%), transparent 70%),
			radial-gradient(55% 55% at 26% 76%, rgb(32 35 161 / 10%), transparent 72%);
		filter: blur(2px);
	}

	@media (prefers-reduced-motion: no-preference) {
		.join__plate::before {
			animation: drift 19s ease-in-out infinite alternate;
		}
	}

	/* La invitación dicha en voz de robot. */
	.join__bubble {
		position: absolute;
		top: 1.15rem;
		right: 1.15rem;
		z-index: 1;
		padding: 0.55rem 1rem;
		border: 1px solid color-mix(in srgb, var(--pop-red) 42%, white);
		border-radius: 1.4rem;
		background: rgb(255 255 255 / 93%);
		color: var(--pop-red);
		font-family: var(--display);
		font-size: clamp(0.85rem, 1.5vw, 1rem);
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.2;
		white-space: nowrap;
		box-shadow: 0 12px 26px rgb(23 23 26 / 10%);
	}

	.join__bubble::after {
		content: "";
		position: absolute;
		left: 1.15rem;
		bottom: -0.4rem;
		width: 0.8rem;
		height: 0.8rem;
		border-right: 1px solid;
		border-bottom: 1px solid;
		border-color: inherit;
		border-radius: 0 0 0.22rem 0;
		background: rgb(255 255 255 / 93%);
		transform: rotate(45deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.join__bubble {
			opacity: 0;
			animation:
				pop-in 0.55s cubic-bezier(0.2, 0.9, 0.3, 1.2) 0.25s forwards,
				bob 5s ease-in-out 0.9s infinite alternate;
		}
	}

	.join__plate img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center;
	}

	.join__plate figcaption {
		margin-top: 0.9rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--line);
		color: var(--ink-faint);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	@media (max-width: 60rem) {
		.join {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				"plate"
				"copy"
				"repos";
		}

		.join__plate {
			max-width: 22rem;
		}
	}

	@media (max-width: 34rem) {
		.contact {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.25rem;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>(".repos");
	const track = root?.querySelector<HTMLElement>(".repos__track");
	if (root && track) {
		const originals = track.children.length;
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const step = () => {
			const card = track.querySelector("li");
			const styles = getComputedStyle(track);
			const gap = Number.parseFloat(styles.columnGap || styles.gap) || 14;
			return (card?.getBoundingClientRect().width ?? 280) + gap;
		};

		const loopWidth = () => {
			const mid = track.children[originals] as HTMLElement | undefined;
			return mid?.offsetLeft ?? 0;
		};

		const wrap = (left: number) => {
			const half = loopWidth();
			if (!half) {
				const max = Math.max(0, track.scrollWidth - track.clientWidth);
				if (left > max) return 0;
				if (left < 0) return max;
				return left;
			}
			while (left >= half) left -= half;
			while (left < 0) left += half;
			return left;
		};

		const cruise = 28;
		let target = 0;
		let velocity = 0;
		let stepping = false;
		let stepTimer = 0;

		const hold = () => {
			target = 0;
		};

		const release = () => {
			if (!stepping) target = cruise;
		};

		const go = (dir: number) => {
			stepping = true;
			target = 0;
			velocity = 0;
			window.clearTimeout(stepTimer);
			track.scrollTo({ left: wrap(track.scrollLeft + dir * step()), behavior: "smooth" });
			stepTimer = window.setTimeout(() => {
				stepping = false;
				if (!root.matches(":hover") && !root.contains(document.activeElement)) target = cruise;
			}, 520);
		};

		for (const button of root.querySelectorAll<HTMLButtonElement>(".repos__btn")) {
			button.addEventListener("click", () => go(Number(button.dataset.dir)));
		}

		if (!reduce && originals > 0) {
			for (const node of [...track.children]) {
				const clone = node.cloneNode(true) as HTMLElement;
				clone.setAttribute("aria-hidden", "true");
				for (const link of clone.querySelectorAll("a")) link.setAttribute("tabindex", "-1");
				track.append(clone);
			}

			target = cruise;
			velocity = cruise;
			let carry = 0;
			let last = performance.now();

			const tick = (now: number) => {
				const dt = Math.min(now - last, 48);
				last = now;
				const tau = target < velocity ? 140 : 320;
				velocity += (target - velocity) * (1 - Math.exp(-dt / tau));
				if (target === 0 && velocity < 0.4) velocity = 0;
				if (!stepping && velocity) {
					carry += (velocity * dt) / 1000;
					const jump = Math.floor(carry);
					if (jump) {
						carry -= jump;
						track.scrollLeft = wrap(track.scrollLeft + jump);
					}
				}
				requestAnimationFrame(tick);
			};

			requestAnimationFrame(tick);
			root.addEventListener("pointerenter", hold);
			root.addEventListener("pointerleave", release);
			root.addEventListener("focusin", hold);
			root.addEventListener("focusout", () => {
				if (!root.contains(document.activeElement)) release();
			});
		}
	}
</script>
