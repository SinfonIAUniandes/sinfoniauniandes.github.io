---
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");

const books = [
	{ href: `${baseUrl}/wiki`, label: "Wiki", icon: "wiki", cloth: "#fff", ink: "#2023a1", edge: "#2023a1" },
	{ href: `${baseUrl}/hall-of-fame`, label: "Hall of Fame", icon: "fame", cloth: "#f6f0d4", ink: "#5c4a0c", edge: "#a88814" },
] as const;
---

<nav class="library is-closed" aria-label="Wiki y Hall of Fame">
	<button
		class="library__toggle"
		type="button"
		aria-expanded="false"
		aria-controls="library-case"
		aria-label="Abrir biblioteca"
	>
		<svg class="library__icon library__icon--open" viewBox="0 0 24 24" aria-hidden="true">
			<rect x="3.5" y="2.2" width="17" height="5.6" rx="1.35" fill="var(--pop-gray)"></rect>
			<rect x="3.5" y="9.2" width="17" height="5.6" rx="1.35" fill="var(--pop-red)"></rect>
			<rect x="3.5" y="16.2" width="17" height="5.6" rx="1.35" fill="var(--pop-blue)"></rect>
			<rect x="16.6" y="2.2" width="2.2" height="5.6" rx="0.45" fill="var(--pop-gold)"></rect>
		</svg>
		<svg class="library__icon library__icon--close" viewBox="0 0 24 24" aria-hidden="true">
			<path
				fill="none"
				stroke="currentColor"
				stroke-linecap="round"
				stroke-width="1.7"
				d="M6 6l12 12M18 6L6 18"
			></path>
		</svg>
	</button>
	<div class="library__case" id="library-case" aria-hidden="true">
		<div class="library__clip">
			<ul class="library__stack" role="list">
				{
					books.map((book, index) => (
						<li style={`--i: ${index}`}>
							<a
								class="book"
								href={book.href}
								style={`--cloth: ${book.cloth}; --ink: ${book.ink}; --edge: ${book.edge}`}
							>
								{book.icon === "wiki" ? (
									<svg class="book__icon" viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="none"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="1.7"
											d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15ZM8 7h8M8 11h6"
										></path>
									</svg>
								) : (
									<svg class="book__icon" viewBox="0 0 24 24" aria-hidden="true">
										<path
											fill="none"
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="1.7"
											d="m12 3 2.4 5.7 6.2.6-4.7 4.1 1.4 6.1L12 16.5 6.7 19.5l1.4-6.1L3.4 9.3l6.2-.6L12 3Z"
										></path>
									</svg>
								)}
								<span class="book__title">{book.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</nav>

<style>
	.library {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 7;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.55rem;
		padding: 1.15rem 1rem 0 0;
		pointer-events: none;
	}

	.library__toggle,
	.library__case {
		pointer-events: auto;
	}

	.library__toggle {
		display: grid;
		place-items: center;
		width: 2.7rem;
		height: 2.7rem;
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--paper);
		color: var(--ink);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease;
	}

	.library__icon {
		grid-area: 1 / 1;
		width: 1.2rem;
		height: 1.2rem;
		transition: opacity 0.28s ease, rotate 0.36s cubic-bezier(0.2, 0.75, 0.25, 1);
	}

	.library__icon--close {
		opacity: 0;
		rotate: 45deg;
		pointer-events: none;
	}

	.library:not(.is-closed) .library__icon--open {
		opacity: 0;
		rotate: -45deg;
		pointer-events: none;
	}

	.library:not(.is-closed) .library__icon--close {
		opacity: 1;
		rotate: 0deg;
	}

	.library__toggle:hover,
	.library__toggle:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}

	.library__case {
		display: grid;
		grid-template-rows: 1fr;
		width: 16.5rem;
		padding: 0.55rem;
		border: 1px solid var(--line);
		border-radius: 1rem;
		background: var(--paper);
		box-shadow: 0 16px 36px rgb(23 23 26 / 8%);
		transition:
			grid-template-rows 0.48s cubic-bezier(0.2, 0.75, 0.25, 1),
			padding 0.48s cubic-bezier(0.2, 0.75, 0.25, 1),
			opacity 0.36s ease,
			border-color 0.36s ease,
			translate 0.48s cubic-bezier(0.2, 0.75, 0.25, 1);
	}

	.library__clip {
		min-height: 0;
		overflow: hidden;
	}

	.library.is-closed .library__case {
		grid-template-rows: 0fr;
		padding-block: 0;
		border-color: transparent;
		opacity: 0;
		translate: 0.85rem 0;
		pointer-events: none;
		box-shadow: none;
	}

	.library__stack {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.library__stack li {
		display: flex;
		height: 3.15rem;
	}

	.book {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		width: 100%;
		min-height: 0;
		padding: 0 1rem 0 0.9rem;
		overflow: hidden;
		border: 1px solid var(--edge);
		border-radius: 0.55rem;
		background: var(--cloth);
		color: var(--ink);
		font-family: var(--display);
		font-size: 1.12rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1;
		text-decoration: none;
		box-shadow: inset 0.45rem 0 0 var(--edge);
		transition:
			translate 0.45s cubic-bezier(0.2, 0.75, 0.25, 1),
			opacity 0.35s ease,
			filter 0.28s ease;
		transition-delay: calc(var(--i, 0) * 70ms);
	}

	.book__icon {
		flex: 0 0 auto;
		width: 1.2rem;
		height: 1.2rem;
	}

	.library.is-closed .book {
		opacity: 0;
		translate: 1.15rem 0;
		transition-delay: calc((1 - var(--i, 0)) * 50ms);
	}

	.book,
	.book:hover,
	.book:focus-visible {
		color: var(--ink);
		text-decoration: none;
	}

	.book__title {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.library:not(.is-closed) .book:hover,
	.library:not(.is-closed) .book:focus-visible {
		translate: -0.28rem 0;
		filter: brightness(1.04);
		transition-delay: 0s;
	}

	@media (prefers-reduced-motion: no-preference) {
		.library {
			opacity: 0;
			animation: library-in 0.55s cubic-bezier(0.2, 0.75, 0.25, 1) 1.7s forwards;
		}
	}

	@keyframes library-in {
		from {
			opacity: 0;
			translate: 0.6rem 0;
		}
		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.library__case,
		.book,
		.library__toggle,
		.library__icon {
			transition: none;
		}

		.library.is-closed .library__case,
		.library:not(.is-closed) .book:hover,
		.library:not(.is-closed) .book:focus-visible {
			translate: none;
		}
	}

	@media (max-width: 60rem) {
		.library {
			top: auto;
			right: 0;
			bottom: 0;
			left: 0;
			align-items: stretch;
			padding: 0;
			transition: left 0.45s cubic-bezier(0.2, 0.75, 0.25, 1);
		}

		.library.is-closed {
			right: 0.85rem;
			bottom: calc(0.85rem + env(safe-area-inset-bottom));
			left: auto;
		}

		.library__toggle {
			align-self: flex-end;
			margin: 0 0.85rem 0.45rem;
			transition: margin 0.45s cubic-bezier(0.2, 0.75, 0.25, 1);
		}

		.library.is-closed .library__toggle {
			margin: 0;
		}

		.library__case {
			width: 100%;
			border-radius: 1rem 1rem 0 0;
			border-bottom: none;
			padding: 0.55rem 0.55rem calc(0.55rem + env(safe-area-inset-bottom));
		}

		.library.is-closed .library__case {
			translate: 0 1.1rem;
			padding-bottom: 0;
		}

		.library.is-closed .book {
			translate: 0 0.7rem;
		}

		.library__stack {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.library__stack li {
			height: 3rem;
		}

		.book {
			font-size: 1rem;
			padding-inline: 0.75rem 0.7rem;
			gap: 0.5rem;
		}

		.library:not(.is-closed) .book:hover,
		.library:not(.is-closed) .book:focus-visible {
			translate: 0 -0.18rem;
		}
	}
</style>

<script>
	const nav = document.querySelector<HTMLElement>(".library");
	const toggle = nav?.querySelector<HTMLButtonElement>(".library__toggle");
	const panel = nav?.querySelector<HTMLElement>(".library__case");
	if (nav && toggle && panel) {
		toggle.addEventListener("click", () => {
			const closed = nav.classList.toggle("is-closed");
			toggle.setAttribute("aria-expanded", String(!closed));
			toggle.setAttribute("aria-label", closed ? "Abrir biblioteca" : "Cerrar biblioteca");
			panel.setAttribute("aria-hidden", String(closed));
		});
	}
</script>
