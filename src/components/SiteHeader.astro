---
import sinfoniaLogo from "../assets/sinfonia.svg";
import uniandesLogo from "../assets/uniandes.png";
import sinfoniaStatic from "../assets/sinfonia-static.svg";
import hallOfFameLogo from "../assets/hall-of-fame.svg";

interface Props {
	animate?: boolean;
	links?: boolean;
}

const { animate = false, links = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");
const homeHref = `${baseUrl}/`;
const hallHref = `${baseUrl}/hall-of-fame`;
const wikiHref = `${baseUrl}/wiki`;
const isHallOfFame = Astro.url.pathname.replace(/\/+$/, "").endsWith("hall-of-fame");
---

<header class="site-header">
	<a
		class:list={[
			"site-header__uni",
			animate
				? "site-header__uni--hero"
				: isHallOfFame
					? "site-header__uni--hall"
					: "site-header__uni--corner",
		]}
		href="https://uniandes.edu.co/"
		target="_blank"
		rel="noreferrer"
		aria-label="Universidad de los Andes"
	>
		<img src={uniandesLogo.src} alt="Universidad de los Andes" loading="eager" decoding="async" />
	</a>

	{animate ? (
		<a
			class="site-header__logo site-header__logo--hero site-header__logo--sinfonia site-header__logo--animate"
			href={homeHref}
			aria-label="SINFONiA home"
		>
			<img src={sinfoniaLogo.src} alt="SINFONiA" />
		</a>
	) : (
		!isHallOfFame && (
			<a
				class="site-header__logo site-header__logo--corner"
				href={homeHref}
				aria-label="SINFONiA home"
			>
				<img src={sinfoniaStatic.src} alt="SINFONiA" />
			</a>
		)
	)}

	{isHallOfFame && (
		<div class="site-header__logo site-header__logo--hero site-header__logo--hall">
			<img src={hallOfFameLogo.src} alt="Hall of Fame" />
		</div>
	)}

	{/*
		En la landing, el logo del salón ocupa la esquina superior derecha,
		donde estaba el botón de la biblioteca. Va con la página, no fijo.
	*/}
	{!isHallOfFame && (
		<a
			class="site-header__logo site-header__logo--hall-link"
			href={hallHref}
			aria-label="Hall of Fame"
		>
			<img src={hallOfFameLogo.src} alt="Hall of Fame" />
		</a>
	)}

	{/*
		En el salón de la fama el botón de la wiki no cabe: en su lugar, a la
		derecha, va el logotipo de SinfonIA de vuelta a la página principal.
	*/}
	{isHallOfFame && (
		<a
			class="site-header__logo site-header__logo--home"
			href={homeHref}
			aria-label="SINFONiA home"
		>
			<img src={sinfoniaStatic.src} alt="SINFONiA" />
		</a>
	)}

	{links && !isHallOfFame && (
		<nav class:list={["site-header__links", animate && "site-header__links--delayed"]}>
			<a class="site-header__link site-header__link--wiki" href={wikiHref}>Wiki</a>
			<a class="site-header__link site-header__link--hall" href={hallHref}>
				Hall of Fame
			</a>
		</nav>
	)}
</header>

<style>
	.site-header {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
	}

	.site-header__logo {
		position: absolute;
		z-index: 5;
		pointer-events: auto;
	}

	.site-header__logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.site-header__logo--corner {
		top: 1.1rem;
		left: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(104px, 16vw, 140px);
	}

	/* El logotipo de SinfonIA que devuelve a la página principal. */
	.site-header__logo--home {
		top: 1.1rem;
		right: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(104px, 16vw, 140px);
	}

	/*
		En la landing el rótulo del salón se queda en la esquina superior
		derecha. No es fijo: se va con la página, como el resto del encabezado.
	*/
	.site-header__logo--hall-link {
		top: 1.4rem;
		right: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(96px, 17vw, 200px);
	}

	.site-header__uni {
		position: absolute;
		z-index: 2;
		pointer-events: auto;
	}

	.site-header__uni img {
		display: block;
		width: 100%;
		height: auto;
	}

	/*
		En la landing el logo vive arriba a la izquierda desde el primer cuadro,
		por debajo del logo SINFONiA mientras este baja del centro (z-index 5).
	*/
	.site-header__uni--hero {
		top: 1.4rem;
		left: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(96px, 14vw, 128px);
	}

	/* En el resto de páginas se apila bajo el logo de SINFONiA. */
	.site-header__uni--corner {
		top: 4.9rem;
		left: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(88px, 12vw, 112px);
	}

	/*
		En el salón de la fama el escudo sube: a la izquierda queda la
		universidad y a la derecha el logotipo de SinfonIA.
	*/
	.site-header__uni--hall {
		top: 1.1rem;
		left: clamp(0.85rem, 3vw, 1.75rem);
		width: clamp(88px, 12vw, 112px);
	}

	.site-header__logo--hero {
		top: 1.25rem;
		left: 50%;
		width: clamp(132px, 18vw, 168px);
		transform: translateX(-50%);
	}

	/*
		En el salón de la fama el rótulo se dibuja donde va a quedarse: el
		trazo vive dentro del SVG. Antes el logo entraba gigante desde el
		centro de la página y barrenba el contenido mientras se dibujaba.
	*/
	.site-header__logo--hall {
		--hall-top: 1.25rem;
		--hall-width: clamp(240px, 44vw, 400px);
		top: var(--hall-top);
		width: var(--hall-width);
	}

	.site-header__logo--animate {
		top: 50%;
		width: min(92vw, 1200px);
		transform: translate(-50%, -50%);
		animation: settle-logo 0.8s cubic-bezier(0.7, 0, 0.25, 1) 0.6s forwards;
	}

	.site-header__logo--sinfonia.site-header__logo--animate {
		animation-delay: 1.05s;
	}

	.site-header__links {
		position: absolute;
		top: 1.5rem;
		right: clamp(1rem, 4vw, 2.5rem);
		z-index: 6;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
		pointer-events: auto;
	}

	.site-header__link {
		font-family: "Lato", sans-serif;
		font-size: clamp(0.84rem, 2vw, 1.08rem);
		font-weight: 700;
		letter-spacing: 0.03em;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-header__link--wiki {
		color: var(--blue);
	}

	.site-header__link--wiki:hover,
	.site-header__link--wiki:focus-visible {
		color: rgb(32 35 161 / 72%);
	}

	.site-header__link--hall {
		color: #c4a027;
		text-shadow:
			0 0 8px rgb(196 197 81 / 70%),
			0 0 22px rgb(196 197 81 / 45%);
	}

	.site-header__link--hall:hover,
	.site-header__link--hall:focus-visible {
		color: #a88814;
		text-shadow:
			0 0 10px rgb(196 197 81 / 90%),
			0 0 28px rgb(196 197 81 / 55%);
	}

	.site-header__link:focus-visible {
		outline: 2px dashed rgb(184, 150, 36);
		outline-offset: 0.3rem;
	}

	.site-header__links--delayed {
		opacity: 0;
		animation: reveal-hall 0.45s ease 1.85s forwards;
	}

	@keyframes settle-logo {
		from {
			top: 50%;
			width: min(92vw, 1200px);
			transform: translate(-50%, -50%);
		}
		to {
			top: 1.25rem;
			width: clamp(132px, 18vw, 168px);
			transform: translate(-50%, 0);
		}
	}

	@keyframes reveal-hall {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@media (max-width: 40rem) {
		.site-header__logo--hall {
			/*
				En pantallas chicas el escudo de los Andes ocupa la esquina
				superior izquierda, así que el rótulo baja y se angosta para
				quedar debajo, sin cruzarse con él.
			*/
			--hall-top: 5.4rem;
			--hall-width: clamp(180px, 64vw, 280px);
		}
	}

	@media (max-width: 30rem) {
		.site-header__links {
			top: 0.55rem;
			right: 0.75rem;
		}

		.site-header__link {
			font-size: 0.8rem;
		}

		.site-header__logo--corner {
			top: 0.75rem;
			width: 96px;
		}

		.site-header__logo--home {
			top: 0.75rem;
			right: 0.75rem;
			width: 96px;
		}

		.site-header__uni--hall {
			top: 0.75rem;
			width: 88px;
		}

		.site-header__uni--hero {
			top: 0.95rem;
			width: 88px;
		}

		.site-header__uni--corner {
			top: 3.55rem;
			width: 88px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header__logo--animate {
			top: 1.25rem;
			width: clamp(132px, 18vw, 168px);
			transform: translateX(-50%);
			animation: none;
		}

		.site-header__links--delayed {
			opacity: 1;
			animation: none;
		}
	}
</style>
